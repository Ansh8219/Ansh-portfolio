# Verified production origin of the website (scheme + host only, no path, no trailing slash).
# REQUIRED for `npm run build`: it feeds canonical URLs, og:url, sitemap.xml, robots.txt and JSON-LD.
# There is deliberately no default — set it in your host's environment settings, or copy this
# file to `.env.production.local` for local production builds.
#
# SITE_URL=https://your-verified-domain.example
SITE_URL=
